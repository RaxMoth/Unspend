<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window while the process starts; replaced by the first Flutter frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- The window behind the Flutter UI while it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/unspend_background</item>
    </style>

    <!-- The app picker. -->
    <style name="PickerTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/unspend_background</item>
        <item name="android:colorAccent">@color/unspend_accent</item>
        <item name="android:textColorPrimary">@color/unspend_text</item>
        <item name="android:textColorSecondary">@color/unspend_text_secondary</item>
        <item name="android:statusBarColor">@color/unspend_background</item>
        <item name="android:navigationBarColor">@color/unspend_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- The screen over a blocked app; dark in both modes. -->
    <style name="BlockTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/unspend_block_background</item>
        <item name="android:statusBarColor">@color/unspend_block_background</item>
        <item name="android:navigationBarColor">@color/unspend_block_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
