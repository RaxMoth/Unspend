<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later draw their own splash screen; give it the app's
     background instead of white or black. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/unspend_background</item>
    </style>
</resources>
