<?xml version="1.0" encoding="utf-8"?>
<!-- The blocker service only learns which app opens a window. It cannot
     read what is on screen (canRetrieveWindowContent is off). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/blocker_service_description"
    android:notificationTimeout="100"
    android:summary="@string/blocker_service_summary" />
